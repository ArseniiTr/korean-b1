{
  "name": "korean-b1-tutor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:schema": "wrangler d1 execute korean-b1 --remote --file=schema.sql",
    "db:import": "wrangler d1 execute korean-b1 --remote --file=migration/data.sql",
    "db:schema:local": "wrangler d1 execute korean-b1 --local --file=schema.sql",
    "db:import:local": "wrangler d1 execute korean-b1 --local --file=migration/data.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.0"
  }
}
